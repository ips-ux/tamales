# Site variables for local development. Copy this file to .env.local at the repository root.
# Vite puts each VITE_ value in the browser bundle. Do not put a secret here.
# Worker secrets are in worker/.dev.vars.example.

# Firebase web config. `npm run firebase:env` writes these 4 values to .env.local.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=bustostamale.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=bustostamale
VITE_FIREBASE_APP_ID=

# URL of the Worker, with no slash at the end. `npm run worker:dev` serves http://127.0.0.1:8787.
VITE_API_BASE_URL=http://127.0.0.1:8787

# Turnstile site key (public). Leave it empty to hide the Turnstile check in local development.
VITE_TURNSTILE_SITE_KEY=
