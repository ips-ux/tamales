rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    /*
      Everything is denied by default. Only the collections matched below are
      reachable.

      Public writes do not exist. The Cloudflare Worker in worker/ is the only
      door for orders, contact messages and email list signups. It writes with
      the service-account key, which is not subject to these rules.

      The owner reads and writes from the browser with the `admin: true`
      custom claim. The public reads the menu, events, locations, business
      settings, site content and site images directly.
    */

    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // Live POS sales. Owner-only, full access.
    match /posTickets/{ticketId} {
      allow read, write: if isAdmin();
    }

    // Owner-editable business settings (timezone, tax rate, contact info).
    // Publicly readable so the customer site can show current contact details;
    // only the owner can change them.
    match /settings/business {
      allow read: if true;
      allow write: if isAdmin();
    }

    // The menu. Publicly readable so the customer site renders it; only the
    // owner edits it from the admin Menu page.
    match /menuItems/{itemId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Accounting/reporting configuration (revenue share, tax filing info,
    // balance sheet inputs). Owner-only.
    match /settings/reporting {
      allow read, write: if isAdmin();
    }

    // Global operating state (test mode). Owner-only.
    match /settings/app {
      allow read, write: if isAdmin();
    }

    // Payment account names (Venmo, Cash App). Public read: the phone of the
    // customer builds the payment link from them. Only the owner edits them.
    match /settings/payments {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Order settings: pickup and delivery switches, delivery rings and fees,
    // batch request limits. Public read. No address is in this document.
    match /settings/ordering {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Delivery start address and the exact batch pickup address. Owner only.
    // The Worker reads it with the service-account key.
    match /settings/orderingPrivate {
      allow read, write: if isAdmin();
    }

    // Events. Public read, so the site shows them. Only the owner edits them.
    // An event holds the area name, never the exact address.
    match /events/{eventId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Tamales that remain for fixed-allotment pre-orders. Public read.
    // The Worker changes the counts in a transaction. The owner can set them.
    match /eventStock/{eventId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // The exact pickup address of an event. Owner only. The Worker sends it
    // to the customer in the payment receipt.
    match /eventPrivate/{eventId} {
      allow read, write: if isAdmin();
    }

    // Order tracker. The document id is an unguessable token. Public get by
    // token, no public list. Only the Worker writes it. It holds no email
    // address, no phone number and no street address.
    match /trackers/{token} {
      allow get: if true;
      allow list: if isAdmin();
      allow write: if false;
    }

    // Waitlist entries. The Worker creates them. Contains customer PII.
    match /waitlist/{entryId} {
      allow read, write: if isAdmin();
    }

    // Order number counters. The Worker changes them in a transaction.
    match /counters/{counterId} {
      allow read, write: if isAdmin();
    }

    // Per-admin flags the `admin` custom claim can't carry (currently just
    // mustChangePassword, set when the owner provisions a new employee with a
    // temporary password). Owner-only, same as every other admin collection.
    match /admins/{uid} {
      allow read, write: if isAdmin();
    }

    // Pickup windows ("pop-up events") and pickup locations backing the
    // pre-order form. There is no separate status doc — the customer site
    // derives "next event" and whether pre-orders are open for it directly
    // from these windows.
    // Publicly readable so the customer site can show what's available;
    // only the owner edits them from the admin Availability page.
    match /availabilityWindows/{windowId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /pickupLocations/{locationId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Stock levels and the adjustment audit log. Owner-only.
    match /inventory/{productId} {
      allow read, write: if isAdmin();
    }

    match /inventoryAdjustments/{adjustmentId} {
      allow read, write: if isAdmin();
    }

    // Expense ledger backing the income statement. Owner-only.
    match /expenses/{expenseId} {
      allow read, write: if isAdmin();
    }

    // Receipt emails + marketing opt-ins collected at POS checkout. Contains
    // customer PII, so owner-only; the drawer runs on the signed-in POS device.
    match /receiptContacts/{contactId} {
      allow read, write: if isAdmin();
    }

    // Orders. The Worker creates each order after it validates the request
    // and computes the prices. The owner lists and updates orders.
    // Interim rule: `get` stays public while the old confirmation page reads
    // 1 order by its unguessable token. New orders have a random document id
    // and use `trackers`. Round 2 of build piece 2 closes the public get.
    match /orders/{orderId} {
      allow get: if true;
      allow list: if isAdmin();
      allow update, delete: if isAdmin();
      allow create: if false;
    }

    // Email list signups. The Worker creates them. Owner-only in the browser.
    match /marketingSignups/{signupId} {
      allow read, write: if isAdmin();
    }

    // Owner-editable site text (hero, About, How It Works, policies, footer).
    match /siteContent/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Owner photos in fixed slots. 1 document for each slot.
    match /siteImages/{slot} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Contact form messages. The Worker creates them. Contains customer PII.
    match /contactMessages/{messageId} {
      allow read, write: if isAdmin();
    }

    // Customer records, keyed by a hash of the email address. The Worker
    // creates and updates them. Contains customer PII.
    match /customers/{customerId} {
      allow read, write: if isAdmin();
    }

    // Default deny for anything not matched above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
