{
  "name": "bangin-bustos-tamales",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -p tsconfig.json && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --exclude \"worker/**\"",
    "firebase:env": "node scripts/write-web-env.mjs",
    "firebase:env:create": "node scripts/write-web-env.mjs --create-if-missing",
    "deploy": "npm run build && firebase deploy --only hosting,firestore",
    "set-admin": "node scripts/set-admin-claim.mjs",
    "worker:dev": "npm --prefix worker run dev",
    "worker:test": "npm --prefix worker test",
    "worker:deploy": "npm --prefix worker run deploy"
  },
  "dependencies": {
    "firebase": "^11.0.0",
    "lucide-react": "^0.468.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "firebase-admin": "^14.5.1",
    "typescript": "^5.8.0",
    "vite": "^7.0.0",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.13.7"
  }
}
